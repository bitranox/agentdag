"""SlopCodeBench agent type that runs one agentdag coordinator run per checkpoint.

Installed into a harness clone by ``scripts/scb_install_agentdag.py`` in the agentdag repo.
Edit the template there; this copy is overwritten by the next install.

The arm this agent exists to run is paired against ``ClaudeCodeAgent``, the single-agent
control. Everything that decides how a checkpoint is run is mirrored from that agent, so the
pair differs in the coordinator and in nothing else: the same container user, the same
workspace mount, the same credential key, and the same Claude Code CLI version, which the
image pins and every node's own transcript records. What differs is what runs inside the
container - one ``agentdag run start plan-goal`` per checkpoint rather than one
``claude --print``.

This module holds what needs the harness's own types. Everything decided by its arguments
alone lives in ``support.py`` beside it, which the agentdag repo executes and tests directly;
this module cannot be imported there at all, so anything left here is covered by reading.

Two things are deliberately NOT mirrored:

* The ``~/.claude`` mount. Coordinator nodes are dispatched with ``setting_sources=[]`` and a
  per-node ``CLAUDE_CONFIG_DIR``, so a shared settings directory would reach nothing and a
  shared trace directory would mix every node's transcript into one tree. The run directory
  is where a coordinator run's own record lives, and it is mounted instead.
* The credential. The control hands the token to the CLI through the environment on every
  invocation; the coordinator needs it on disk, because it dispatches its own children. One
  bootstrap command writes it to a keyfile, taking the value from the environment so that it
  never appears in a command string.
"""

from __future__ import annotations

import shlex
import shutil
import tempfile
import typing as tp
from pathlib import Path

from jinja2 import Template
from pydantic import Field
from pydantic import JsonValue

from slop_code.agent_runner.agent import Agent
from slop_code.agent_runner.agent import AgentConfigBase
from slop_code.agent_runner.agents.utils import HOME_PATH
from slop_code.agent_runner.credentials import ProviderCredential
from slop_code.agent_runner.models import AgentCostLimits
from slop_code.agent_runner.models import AgentError
from slop_code.agent_runner.registry import register_agent
from slop_code.common.llms import APIPricing
from slop_code.common.llms import ModelDefinition
from slop_code.common.llms import ThinkingPreset
from slop_code.common.llms import TokenUsage
from slop_code.execution import DockerEnvironmentSpec
from slop_code.execution import EnvironmentSpec
from slop_code.execution import Session
from slop_code.execution import StreamingRuntime
from slop_code.execution.runtime import RuntimeResult
from slop_code.logging import get_logger

from .support import DONE_OUTCOME
from .support import PGID_FILE_NAME
from .support import SUSPENDED_PREFIX
from .support import LaunchSpec
from .support import count_steps
from .support import launch_command
from .support import parsed_record_list
from .support import skip_node_homes
from .support import spend_of
from .support import terminal_line
from .support import uncosted_refusal

log = get_logger(__name__)

OAUTH_CREDENTIAL_KEY = "CLAUDE_CODE_OAUTH_TOKEN"
"""The only credential this agent accepts. Anything else is refused before an image is built."""

WORKFLOW = "plan-goal"
"""The shipped agentdag workflow this arm runs: a planner decomposes the goal, and the plan
it emits is what the coordinator dispatches."""

CONTAINER_WORKSPACE = "/workspace"
"""Where the harness mounts the problem. It is the environment config's ``docker.workdir``
and the second isolation root every dispatched node is bounded by."""

RUNS_DIR = f"{HOME_PATH}/agentdag-runs"
"""Where a coordinator run's own directory is created, inside a host bind mount.

Inside the container overlay it would be lost with the container and would count against the
overlay's size; on a bind mount it survives, and ``save_artifacts`` can harvest it."""

KEYFILE = f"{HOME_PATH}/.agentdag/oauth-token"
"""Where the bootstrap command writes the OAuth token for the coordinator to read."""

POLICY_FILE = f"{HOME_PATH}/agentdag-policy.yaml"
"""Where an arm-supplied tier policy is mounted read-only, when the config names one.

A sibling of the run mount rather than a file inside it: the run store is harvested into the
checkpoint's artifacts, and a policy is the arm's configuration, not a run's own record."""

PGID_FILE = f"{RUNS_DIR}/{PGID_FILE_NAME}"
"""Where the launcher records its own process-group id, for the wall-clock kill to aim at."""


def usage_from_records(records: list[dict[str, tp.Any]]) -> tuple[float, TokenUsage]:
    """Total a coordinator run's cost and tokens from its own result records.

    A run whose records report no cost at all is refused rather than costed at zero. Some
    records legitimately carry none - a gate node runs pytest and spends nothing - but a run
    always dispatches at least its planner, so none at all means the cost was not reported
    (or, when there are no records whatsoever, that the planner never dispatched) rather than
    not incurred, and this arm exists to be counted against a control.

    Args:
        records: What ``agentdag run records <id> --json`` printed.

    Returns:
        The run's total cost in dollars and its token usage in the harness's own shape.

    Raises:
        AgentError: Not one record reported a cost.
    """
    refusal = uncosted_refusal(records)
    if refusal is not None:
        raise AgentError(refusal)
    spend = spend_of(records)
    return spend.cost_usd, TokenUsage(
        input=spend.tokens.input,
        output=spend.tokens.output,
        cache_read=spend.tokens.cache_read,
        cache_write=spend.tokens.cache_write,
        reasoning=spend.tokens.reasoning,
    )


class AgentdagConfig(AgentConfigBase):
    """Configuration for :class:`AgentdagAgent`.

    Three version fields rather than one, because three separate things are pinned: which
    coordinator runs (``version``), which Claude Code CLI its nodes run (``cli_version``, the
    arm-fairness axis), and which SDK drives that CLI (``sdk_version``).
    """

    type: tp.Literal["agentdag"] = "agentdag"
    version: str
    """The agentdag git ref the image installs. Also the image tag, via ``get_image``."""
    cli_version: str
    """The Claude Code CLI version the image installs on PATH."""
    sdk_version: str
    """The ``claude-agent-sdk`` version the coordinator drives that CLI with."""
    timeout: int | None = Field(
        default=None,
        description="Wall-clock ceiling in seconds for one checkpoint's coordinator run.",
    )
    policy: Path | None = Field(
        default=None,
        description="A tier policy YAML on the host, mounted in and passed as --policy; "
        "unset runs agentdag's shipped tier table.",
    )
    settings: dict[str, JsonValue] = Field(
        default_factory=dict,
        description="agentdag configuration, rendered one --set SECTION.KEY=VALUE each.",
    )
    docker_template: Path = Path(__file__).parent / "docker.j2"

    def get_docker_file(self, base_image: str) -> str | None:
        """Render the image, giving the template all three pins rather than only ``version``."""
        if self.docker_template is None:
            return None
        return Template(self.docker_template.read_text()).render(
            base_image=base_image,
            version=self.version,
            cli_version=self.cli_version,
            sdk_version=self.sdk_version,
        )


class AgentdagAgent(Agent):
    """Runs one agentdag coordinator run per checkpoint inside the harness's container."""

    def __init__(
        self,
        problem_name: str,
        image: str,
        verbose: bool,  # noqa: FBT001
        cost_limits: AgentCostLimits,
        pricing: APIPricing | None,
        credential: ProviderCredential,
        settings: dict[str, JsonValue],
        timeout: int | None,
        policy: Path | None,
    ) -> None:
        super().__init__(
            agent_name="agentdag",
            problem_name=problem_name,
            cost_limits=cost_limits,
            pricing=pricing,
            verbose=verbose,
        )
        self.credential = credential
        self.settings = settings
        self.timeout = timeout
        self.policy = policy
        self._image = image
        self._session: Session | None = None
        self._environment: EnvironmentSpec | None = None
        self._workspace: Path | None = None
        self._runtime: StreamingRuntime | None = None
        self._tmp_dir: tempfile.TemporaryDirectory[str] | None = None
        self._runs_host: Path | None = None
        self._run_ids: list[str] = []
        self.suspended_at: str | None = None
        self.final_result: RuntimeResult | None = None

    @classmethod
    def _from_config(
        cls,
        config: AgentConfigBase,
        model: ModelDefinition,
        credential: ProviderCredential,
        problem_name: str,
        verbose: bool,  # noqa: FBT001
        image: str | None,
        thinking_preset: ThinkingPreset | None = None,
        thinking_max_tokens: int | None = None,
    ) -> Agent:
        """Build an agent from its config, refusing anything this arm cannot run faithfully."""
        if not isinstance(config, AgentdagConfig):
            raise TypeError(f"Expected AgentdagConfig, got {type(config).__name__}")
        if image is None:
            raise ValueError("AgentdagAgent requires an image")
        if credential.destination_key != OAUTH_CREDENTIAL_KEY:
            raise AgentError(
                f"AgentdagAgent runs on a {OAUTH_CREDENTIAL_KEY} credential only; "
                f"this run resolved {credential.destination_key!r}"
            )
        if thinking_preset is not None or thinking_max_tokens is not None:
            # Stated rather than silently dropped: agentdag resolves a node's effort from its
            # own tier policy, so the run config's thinking preset reaches nothing here. The
            # policy field is the lever for that axis.
            log.info(
                "agent.agentdag.thinking_not_forwarded",
                thinking=thinking_preset,
                max_thinking_tokens=thinking_max_tokens,
            )
        return cls(
            problem_name=problem_name,
            image=image,
            verbose=verbose,
            cost_limits=config.cost_limits,
            pricing=model.pricing,
            credential=credential,
            settings=dict(config.settings),
            timeout=config.timeout,
            policy=_resolved_policy(config.policy),
        )

    @property
    def session(self) -> Session:
        if self._session is None:
            raise AgentError("AgentdagAgent has not been set up with a session")
        return self._session

    @property
    def spec(self) -> EnvironmentSpec:
        if self._environment is None:
            raise AgentError("AgentdagAgent has not been set up with a session")
        return self._environment

    @property
    def workspace(self) -> Path:
        if self._workspace is None:
            raise AgentError("AgentdagAgent has not been set up with a session")
        return self._workspace

    @property
    def runtime(self) -> StreamingRuntime:
        if self._runtime is None:
            raise AgentError("AgentdagAgent has not been set up with a runtime")
        return self._runtime

    @property
    def runs_host(self) -> Path:
        """The host side of the run mount, where a finished run can be read and copied."""
        if self._runs_host is None:
            raise AgentError("AgentdagAgent has no run mount; it was not set up under Docker")
        return self._runs_host

    def setup(self, session: Session) -> None:
        """Spawn the container and put the coordinator's credential on disk inside it."""
        self._session = session
        self._environment = session.spec
        self._workspace = session.working_dir
        self._tmp_dir = tempfile.TemporaryDirectory()
        under_docker = isinstance(session.spec, DockerEnvironmentSpec)
        if self.policy is not None and not under_docker:
            raise AgentError("the arm's tier policy is delivered by a bind mount, which needs a Docker environment")
        mounts: dict[str, dict[str, str] | str] = self._prepare_mounts() if under_docker else {}
        self._runtime = session.spawn(
            mounts=mounts,
            env_vars={"HOME": HOME_PATH},
            image=self._image,
            user="1000:1000",
            disable_setup=True,
        )
        self._write_keyfile()
        self.log.debug(
            "agent.agentdag.setup",
            workspace=str(self._workspace),
            environment_type=self.spec.type,
            image=self._image,
            runs_dir=RUNS_DIR,
            policy=str(self.policy) if self.policy is not None else None,
        )

    def _prepare_mounts(self) -> dict[str, dict[str, str] | str]:
        """Bind a host temporary directory in as the run store, and the tier policy beside it.

        The run store is world-writable for the same reason the control's settings mount is:
        the container writes as uid 1000 whatever uid the harness itself runs as. The policy
        goes in read-only, because nothing in the run may rewrite what the arm was configured
        with.
        """
        if self._tmp_dir is None:
            raise AgentError("AgentdagAgent has not been set up with a tmp dir")
        runs_host = Path(self._tmp_dir.name) / "agentdag_runs"
        runs_host.mkdir(parents=True, exist_ok=True)
        runs_host.chmod(0o777)
        self._runs_host = runs_host
        mounts: dict[str, dict[str, str] | str] = {str(runs_host): {"bind": RUNS_DIR, "mode": "rw"}}
        if self.policy is not None:
            mounts[str(self.policy)] = {"bind": POLICY_FILE, "mode": "ro"}
        return mounts

    def _write_keyfile(self) -> None:
        """Write the OAuth token where the coordinator reads it, taking it from the environment.

        The token is passed as an environment variable and referenced by name, so it is not
        part of any command string this agent builds. ``umask`` before the ``mkdir`` so the
        directory is private too, not only the file.
        """
        directory = shlex.quote(str(Path(KEYFILE).parent))
        keyfile = shlex.quote(KEYFILE)
        command = (
            f"set -eu; umask 077; mkdir -p {directory}; "
            f'printf %s "${OAUTH_CREDENTIAL_KEY}" > {keyfile}; chmod 600 {keyfile}'
        )
        result = self._stream(command, env={OAUTH_CREDENTIAL_KEY: self.credential.value}, timeout=60.0)
        if result.exit_code != 0:
            raise AgentError(f"could not write the coordinator's keyfile (exit {result.exit_code})")

    def run(self, task: str) -> None:
        """Run one coordinator run for this checkpoint and read what it spent.

        A run that SUSPENDS is a normal end: the coordinator asked a question nobody was there
        to answer, whatever landed in the workspace is what the checkpoint is scored on, and
        the node it suspended at is recorded.

        Args:
            task: The checkpoint prompt, which becomes the root planner's goal.

        Raises:
            AgentError: The launch produced no result, timed out, printed no terminal line, or
                ended in a status that is neither done nor suspended.
        """
        self.suspended_at = None
        self.log.info("agent.agentdag.start", workspace=str(self.workspace), prompt_chars=len(task))
        before = self._run_directories()
        result = self._stream(self._launch_command(task), env={}, timeout=self._timeout_s())
        self.final_result = result
        if result.timed_out:
            self._kill_launched_group()
            raise AgentError(f"agentdag run timed out after {self.timeout}s; {self._harvest_abandoned(before)}")
        run_id, outcome = self._terminal_line(result)
        self._run_ids.append(run_id)
        if outcome.startswith(SUSPENDED_PREFIX):
            self.suspended_at = outcome[len(SUSPENDED_PREFIX) :]
        self._harvest(run_id)
        self.log.info(
            "agent.agentdag.finished",
            run_id=run_id,
            outcome=outcome,
            cost=self.usage.cost,
            steps=self.usage.steps,
        )
        if outcome != DONE_OUTCOME and self.suspended_at is None:
            raise AgentError(f"agentdag run {run_id} ended {outcome!r}")

    def _timeout_s(self) -> float | None:
        return float(self.timeout) if self.timeout is not None else None

    def _launch_command(self, task: str) -> str:
        """The shell command that launches this checkpoint's coordinator run."""
        spec = LaunchSpec(
            goal=task,
            workflow=WORKFLOW,
            workspace=CONTAINER_WORKSPACE,
            runs_dir=RUNS_DIR,
            keyfile=KEYFILE,
            settings=self.settings,
            policy=POLICY_FILE if self.policy is not None else None,
        )
        try:
            return launch_command(spec)
        except ValueError as exc:
            raise AgentError(str(exc)) from exc

    def _terminal_line(self, result: RuntimeResult) -> tuple[str, str]:
        """The run id and terminal status, or a refusal naming what came back instead."""
        read = terminal_line(result.stdout or "")
        if read is not None:
            return read
        tail = "\n".join((result.stderr or "").splitlines()[-20:])
        raise AgentError(f"agentdag printed no terminal line (exit {result.exit_code}); stderr tail:\n{tail}")

    def _run_directories(self) -> set[str]:
        """The run directories in the store now, so a stop can name the one a launch created."""
        if self._runs_host is None or not self._runs_host.is_dir():
            return set()
        return {entry.name for entry in self._runs_host.iterdir() if entry.is_dir()}

    def _harvest_abandoned(self, before: set[str]) -> str:
        """Harvest a killed run's spend, and report what was recovered.

        A run stopped at the wall clock never printed its terminal line, so its id cannot come
        from stdout; it is the single directory the launch added to the run store, which is a
        set difference over a directory this agent owns rather than a guess at the newest one.
        Real spend recorded as zero would corrupt exactly the measurement this arm exists for.
        """
        appeared = sorted(self._run_directories() - before)
        if len(appeared) != 1:
            return f"{len(appeared)} run directories appeared, so this checkpoint's spend is unaccounted"
        run_id = appeared[0]
        self._run_ids.append(run_id)
        try:
            self._harvest(run_id)
        except AgentError as exc:
            return f"run {run_id} was left behind and its spend could not be read: {exc}"
        return f"run {run_id}'s spend was harvested before this stop"

    def _kill_launched_group(self) -> None:
        """Signal the launched process group, so a timeout stops the nodes and not just the client."""
        pgid = self._launched_pgid()
        if pgid is None:
            self.log.error("agent.agentdag.kill.no_pgid", pgid_file=PGID_FILE)
            return
        self._stream(f"kill -TERM -{pgid} 2>/dev/null || true", env={}, timeout=30.0)
        self.log.info("agent.agentdag.killed", pgid=pgid)

    def _launched_pgid(self) -> int | None:
        """The launcher's recorded process-group id, or ``None`` when it never wrote one."""
        if self._runs_host is None:
            return None
        recorded = self._runs_host / PGID_FILE_NAME
        if not recorded.is_file():
            return None
        text = recorded.read_text(encoding="utf-8", errors="replace").strip()
        # Validated rather than interpolated as read: it becomes part of a shell command.
        if not text.isdigit() or int(text) <= 0:
            return None
        return int(text)

    def _harvest(self, run_id: str) -> None:
        """Add one run's cost, tokens and steps to this checkpoint's usage."""
        cost, tokens = usage_from_records(self._records(run_id))
        self.usage.cost += cost
        self.usage.net_tokens += tokens
        self.usage.current_tokens = tokens
        if self._runs_host is not None:
            self.usage.steps += count_steps(self._runs_host / run_id)

    def _records(self, run_id: str) -> list[dict[str, tp.Any]]:
        """Read one run's result records through the coordinator's own reporting command.

        Raised rather than defaulted to nothing on failure: a checkpoint silently costed at
        zero is worse than a checkpoint that stops and says why.
        """
        command = " ".join(
            shlex.quote(part) for part in ["agentdag", "run", "records", run_id, "--runs", RUNS_DIR, "--json"]
        )
        result = self._stream(command, env={}, timeout=300.0)
        if result.exit_code != 0:
            raise AgentError(f"could not read records for run {run_id} (exit {result.exit_code})")
        for line in reversed((result.stdout or "").splitlines()):
            parsed = parsed_record_list(line)
            if parsed is not None:
                return parsed
        raise AgentError(f"records for run {run_id} were not a JSON array")

    def _stream(self, command: str, *, env: dict[str, str], timeout: float | None) -> RuntimeResult:
        """Run one command in the container and return its result."""
        for event in self.runtime.stream(command=command, env=env, timeout=timeout):
            if event.kind == "finished" and event.result is not None:
                return event.result
        raise AgentError("the container produced no result for a command")

    def reset(self) -> None:
        """Forget the previous checkpoint's runs; its artifacts have already been saved."""
        self._run_ids = []
        self.suspended_at = None
        self.final_result = None

    def save_artifacts(self, path: Path) -> None:
        """Save the launch output and every run directory this checkpoint produced."""
        path.mkdir(parents=True, exist_ok=True)
        if self.final_result is not None:
            (path / "stdout.log").write_text(self.final_result.stdout or "", encoding="utf-8")
            (path / "stderr.log").write_text(self.final_result.stderr or "", encoding="utf-8")
        if self.suspended_at is not None:
            (path / "suspended_at.txt").write_text(f"{self.suspended_at}\n", encoding="utf-8")
        saved = 0
        for run_id in self._run_ids:
            saved += self._save_run(run_id, path / "runs" / run_id)
        self.log.debug("agent.agentdag.artifacts.saved", output_dir=str(path), runs=saved)

    def _save_run(self, run_id: str, destination: Path) -> int:
        """Copy one run directory minus its node homes; 0 when there was nothing to copy."""
        if self._runs_host is None:
            return 0
        source = self._runs_host / run_id
        if not source.is_dir():
            self.log.error("agent.agentdag.artifacts.missing_run", run_id=run_id)
            return 0
        shutil.copytree(source, destination, ignore=skip_node_homes(source), dirs_exist_ok=True)
        return 1

    def cleanup(self) -> None:
        """Release the session and the host-side run mount."""
        self._session = None
        if self._tmp_dir is not None:
            self._tmp_dir.cleanup()
            self._tmp_dir = None
        self._runs_host = None
        self.log.debug("agent.agentdag.cleanup")


def _resolved_policy(policy: Path | None) -> Path | None:
    """Resolve the arm's tier policy, refusing one that is not a readable file.

    Refused here rather than at launch: this runs before an image is built, so a mistyped
    path costs nothing, while the same mistake reaching the mount would fail every checkpoint
    of the arm one container at a time.

    Args:
        policy: What the arm config named, or ``None`` for the shipped tier table.

    Returns:
        The absolute path to mount, or ``None``.

    Raises:
        AgentError: The named path is not a file.
    """
    if policy is None:
        return None
    resolved = policy.expanduser().resolve()
    if not resolved.is_file():
        raise AgentError(f"the arm config names a tier policy that is not a readable file: {resolved}")
    return resolved


register_agent("agentdag", AgentdagAgent)
