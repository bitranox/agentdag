.venv-win/
.venv-bmk/

# Python virtual environments (managed by bmk)
.venv*/

# Local private-marker list read by tests/test_repo_publishable.py. Gitignored on purpose:
# a shipped blocklist of hostnames publishes exactly what it exists to keep out.
.private-markers

# Autonomous-execution decision log: never committed HERE, and since 2026-09-01 this path
# is a symlink to its one real home in the private research repo. It stays private because
# its spend figures are the subject of their own sentences, so redacting them would destroy
# the entries rather than clean them.
EXECUTION-USER-REVIEW.md

# Session handover: TRACKED since 2026-09-01, so it gets a history instead of being
# rewritten wholesale into oblivion. Only its editor backups stay out.
handover.md.bak-*

